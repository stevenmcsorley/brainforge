# ===========================================
# BRAINFORGE Environment Variables
# ===========================================
# Copy this file to .env and adjust values

# --- Database ---
DATABASE_URL=postgresql://brainforge:brainforge_dev@localhost:5432/brainforge
POSTGRES_USER=brainforge
POSTGRES_PASSWORD=brainforge_dev
POSTGRES_DB=brainforge

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# --- Simulation Worker ---
SIM_WORKER_REDIS_URL=redis://localhost:6379
SIM_WORKER_API_URL=http://localhost:3001
SIM_WORKER_STORAGE_PATH=/storage

# --- Storage ---
STORAGE_PATH=./storage
